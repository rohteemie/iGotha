# Test Environment Configuration Template
# Copy this file to .env.test for running tests

# Database Configuration (SQLite for testing)
DB=:memory:
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_DIALECT=sqlite

# JWT Configuration
JWT_SECRET=test-secret-key-for-jwt-tokens-do-not-use-in-production
EXPIRE_IN=1h
REFRESH_EXPIRE_IN=7d

# Node Environment
NODE_ENV=test

# Server Configuration
PORT=3001
